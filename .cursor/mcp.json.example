{
  "mcpServers": {
    "tradingview": {
      "command": "node",
      "args": [
        "/ABSOLUTE/PATH/TO/tradingview-mcp/src/server.js"
      ]
    },
    "bybit": {
      "command": "node",
      "args": [
        "./node_modules/bybit-mcp-server/dist/index.js"
      ],
      "env": {
        "BYBIT_API_KEY": "REPLACE_ME",
        "BYBIT_API_SECRET": "REPLACE_ME",
        "BYBIT_ENVIRONMENT": "mainnet"
      }
    }
  }
}
